---
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta
      name="description"
      content="CyPedia — The Cyber Security Wiki"
    />

    <title>CyPedia — The Cyber Security Wiki</title>

    <style>
      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        min-height: 100%;
      }

      body {
        font-family:
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          "Noto Sans JP",
          sans-serif;
        color: #202122;
        background: #ffffff;
      }

      .topbar {
        min-height: 88px;
        display: flex;
        align-items: center;
        padding: 0 60px;
        border-bottom: 1px solid #a2a9b1;
        background: #eaecf0;
      }

      .brand {
        display: flex;
        align-items: baseline;
        gap: 10px;
      }

      .brand-name {
        margin: 0;
        font-size: 27px;
        font-weight: 700;
        color: #7654c4;
      }

      .brand-subtitle {
        font-family: Georgia, serif;
        font-size: 13px;
        font-weight: 600;
        color: #202122;
      }

      main {
        width: min(920px, calc(100% - 40px));
        margin: 90px auto;
      }

      .landing {
        border-top: 1px solid #a2a9b1;
        border-bottom: 1px solid #a2a9b1;
        padding: 48px 54px 52px;
      }

      h1 {
        margin: 0;
        font-size: 40px;
        line-height: 1.2;
      }

      .tagline {
        margin: 10px 0 0;
        font-family: Georgia, serif;
        font-size: 18px;
      }

      .intro {
        margin: 34px 0 10px;
        font-size: 16px;
        line-height: 1.8;
      }

      .select-label {
        margin: 0 0 24px;
        color: #54595d;
      }

      .languages {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
      }

      .language {
        display: block;
        padding: 24px 26px;
        border: 1px solid #a2a9b1;
        text-decoration: none;
        color: #202122;
        background: #f8f9fa;
      }

      .language:hover {
        border-color: #7654c4;
        background: #ffffff;
      }

      .language strong {
        display: block;
        margin-bottom: 5px;
        font-size: 20px;
        color: #5b42b5;
      }

      .language span {
        font-size: 14px;
        color: #54595d;
      }

      footer {
        width: min(920px, calc(100% - 40px));
        margin: 22px auto 0;
        font-family: Georgia, serif;
        font-size: 12px;
        color: #54595d;
      }

      @media (max-width: 700px) {
        .topbar {
          padding: 0 24px;
        }

        .brand {
          display: block;
        }

        .brand-subtitle {
          display: block;
          margin-top: 2px;
        }

        main {
          margin-top: 40px;
        }

        .landing {
          padding: 32px 24px;
        }

        h1 {
          font-size: 32px;
        }

        .languages {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>

  <body>
    <header class="topbar">
      <div class="brand">
        <div class="brand-name">CyPedia</div>
        <div class="brand-subtitle">
          The Cyber Security Wiki
        </div>
      </div>
    </header>

    <main>
      <section class="landing">
        <h1>CyPedia</h1>

        <p class="tagline">
          The Cyber Security Wiki
        </p>

        <p class="intro">
          サイバーセキュリティに関する用語、概念、技術、
          プロトコル、攻撃手法などを横断的に参照できる百科事典です。
        </p>

        <p class="select-label">
          Language / 言語を選択してください
        </p>

        <div class="languages">
          <a
            class="language"
            href={`${base}ja/`}
          >
            <strong>日本語</strong>
            <span>Japanese</span>
          </a>

          <a
            class="language"
            href={`${base}en/`}
          >
            <strong>English</strong>
            <span>英語</span>
          </a>
        </div>
      </section>
    </main>

    <footer>
      CyPedia — The Cyber Security Wiki
    </footer>
  </body>
</html>
