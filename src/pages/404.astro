---
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width"
  />
  <meta name="robots" content="noindex" />
  <title>ページが見つかりません - CyPedia</title>

  <style>
    body {
      max-width: 820px;
      margin: 70px auto;
      padding: 0 20px;
      font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        "Noto Sans JP",
        sans-serif;
      line-height: 1.7;
    }

    a {
      color: #3366cc;
    }

    h1 {
      border-bottom: 1px solid #a2a9b1;
    }
  </style>
</head>

<body>
  <h1>ページが見つかりません</h1>

  <p>
    指定されたCyPediaの項目は存在しません。
  </p>

  <p id="suggestion"></p>

  <p>
    <a id="search-link" href={`${base}ja/search/`}>
      CyPediaを検索
    </a>
    /
    <a href={`${base}ja/`}>
      トップページ
    </a>
  </p>

  <script is:inline define:vars={{ base }}>
    const path =
      window.location.pathname;

    const isEnglish =
      path.includes('/en/');

    const pieces =
      path
        .split('/')
        .filter(Boolean);

    const term =
      decodeURIComponent(
        pieces.at(-1) ?? ''
      )
        .replaceAll('-', ' ')
        .trim();

    const lang =
      isEnglish ? 'en' : 'ja';

    const search =
      document.getElementById(
        'search-link'
      );

    const suggestion =
      document.getElementById(
        'suggestion'
      );

    if (isEnglish) {
      document.documentElement.lang = 'en';
      document.title =
        'Page not found - CyPedia';

      document.querySelector('h1')
        .textContent =
          'Page not found';

      document.querySelector('body > p')
        .textContent =
          'The requested CyPedia entry does not exist.';

      search.textContent =
        'Search CyPedia';
    }

    if (term) {
      search.href =
        `${base}${lang}/search/?q=` +
        encodeURIComponent(term);

      suggestion.textContent =
        isEnglish
          ? `Search for "${term}" instead.`
          : `「${term}」を検索できます。`;
    } else {
      search.href =
        `${base}${lang}/search/`;
    }
  </script>
</body>
</html>
